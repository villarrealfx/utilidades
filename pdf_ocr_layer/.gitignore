# Entorno de uv (también cubierto por el .gitignore raíz)
.venv/
__pycache__/

# Salidas que genera el propio script (main.py entrada.pdf -> entrada_texto.pdf)
*_texto.pdf
*_texto.txt

# Datos de prueba: documentos usados para probar el script, nunca se versionan
# (incluye tests/fixture_scanned.pdf, regenerable con tests/make_fixture.py)
tests/*.pdf
tests/*.txt
